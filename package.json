{
    "name": "absolute-scenes",
    "version": "1.3.7",
    "description": "A scene-based book writing application",
    "main": "public/electron.js",
    "homepage": "./",
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "electron": "electron .",
        "electron-dev": "cross-env ELECTRON_IS_DEV=true electron .",
        "electron-dev-cmd": "set ELECTRON_IS_DEV=true && electron .",
        "electron-dev-powershell": "$env:ELECTRON_IS_DEV=\"true\"; electron .",
        "dist": "npx auto-version --patch && npm run build && electron-builder"
    },
    "dependencies": {
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.1",
        "jszip": "^3.10.1",
        "octokit": "^2.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-scripts": "5.0.1",
        "simple-git": "^3.19.1"
    },
    "devDependencies": {
        "auto-version-js": "^0.3.10",
        "cross-env": "^7.0.3",
        "electron": "^25.0.0",
        "electron-builder": "^24.0.0"
    },
    "build": {
        "appId": "com.absolutescenes.app",
        "productName": "Absolute Scenes",
        "directories": {
            "output": "dist"
        },
        "files": [
            "build/**/*",
            "node_modules/**/*"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}