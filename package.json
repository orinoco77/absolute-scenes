{
    "name": "absolute-scenes",
    "version": "1.4.30",
    "description": "A scene-based book writing application",
    "main": "public/electron.js",
    "homepage": "./",
    "author": "Adam Short <ajs@shiny.org.uk>",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "electron": "electron .",
        "electron-dev": "cross-env ELECTRON_IS_DEV=true electron .",
        "electron-dev-cmd": "set ELECTRON_IS_DEV=true && electron .",
        "electron-dev-powershell": "$env:ELECTRON_IS_DEV=\"true\"; electron .",
        "dist": "npm run build && electron-builder",
        "postinstall": "electron-builder install-app-deps",
        "lint": "eslint src/ public/ --ext .js,.jsx",
        "lint:fix": "eslint src/ public/ --ext .js,.jsx --fix",
        "lint:check": "eslint src/ public/ --ext .js,.jsx --max-warnings 0",
        "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\" \"public/**/*.{js,json}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\" \"public/**/*.{js,json}\"",
        "prepare": "husky"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.8.11",
        "electron-store": "^10.1.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^3.0.2",
        "jszip": "^3.10.1",
        "octokit": "^3.1.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "rtf-parse": "^0.1.0",
        "rtf-parser": "^1.3.3",
        "rtf-parser-wasm": "^0.4.2",
        "simple-git": "^3.19.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.28.0",
        "@babel/preset-react": "^7.27.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^5.0.2",
        "auto-version-js": "^0.3.10",
        "babel-jest": "^30.0.5",
        "cross-env": "^7.0.3",
        "electron": "^35.7.5",
        "electron-builder": "^24.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "^9.1.7",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.2.5",
        "vite": "^7.1.5"
    },
    "build": {
        "appId": "com.absolutescenes.app",
        "productName": "Absolute Scenes",
        "directories": {
            "output": "dist"
        },
        "icon": "assets/icon.png",
        "files": [
            "build/**/*",
            "node_modules/**/*",
            "public/electron.js"
        ],
        "fileAssociations": [
            {
                "ext": "book",
                "name": "Absolute Scenes Book",
                "description": "Absolute Scenes Book File",
                "mimeType": "application/x-absolute-scenes-book",
                "role": "Editor"
            }
        ],
        "protocols": [
            {
                "name": "absolute-scenes",
                "schemes": [
                    "absolute-scenes"
                ]
            }
        ],
        "win": {
            "icon": "assets/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "certificateFile": "cert/windows-cert.p12",
            "certificatePassword": "",
            "publisherName": "Adam Short"
        },
        "nsis": {
            "artifactName": "${productName} Setup ${version}.${ext}",
            "oneClick": false,
            "perMachine": true,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Absolute Scenes",
            "include": "assets/installer.nsh",
            "runAfterFinish": false,
            "displayLanguageSelector": true,
            "installerLanguages": [
                "en_US"
            ],
            "warningsAsErrors": false
        },
        "mac": {
            "icon": "assets/icon.png",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.productivity",
            "hardenedRuntime": false,
            "gatekeeperAssess": false,
            "entitlements": "assets/entitlements.mac.plist",
            "entitlementsInherit": "assets/entitlements.mac.plist",
            "identity": null
        },
        "dmg": {
            "title": "${productName} ${version}",
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ],
            "window": {
                "width": 540,
                "height": 380
            }
        },
        "linux": {
            "icon": "assets/icon.png",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Office",
            "desktop": {
                "Name": "Absolute Scenes",
                "Comment": "A scene-based book writing application",
                "Keywords": "writing;book;editor;scenes;",
                "StartupWMClass": "absolute-scenes"
            },
            "executableName": "absolute-scenes"
        },
        "deb": {
            "priority": "optional",
            "afterInstall": "assets/linux-post-install.sh",
            "afterRemove": "assets/linux-post-remove.sh"
        },
        "rpm": {
            "fpm": [
                "--after-install=assets/linux-post-install.sh",
                "--after-remove=assets/linux-post-remove.sh"
            ]
        }
    },
    "overrides": {
        "nth-check": ">=2.0.1",
        "postcss": ">=8.4.31",
        "webpack-dev-server": "^4.15.2"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}